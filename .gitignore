# ---------- PyInstaller ----------
# The spec file is regenerated by PyInstaller on every build; it encodes
# absolute paths from your machine, so it never belongs in the repo.
*.spec

# Intermediate build files (analysis, PYZ, PKG, etc.)
build/

# Packaged output. Comment this out if you intentionally ship the exe
# via the repo (e.g. for non-technical users); otherwise leave it ignored.
dist/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class

# C-extension / build leftovers
*.so
*.pyd
*.egg-info/
.eggs/

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/

# ---------- App runtime data ----------
# Created next to the script/exe on first launch. Contains state.json
# (user's folder path, crops, transforms, window geometry) and cache/*.bmp
# (generated wallpaper files). Purely local — never commit.
wallpapermanager_data/

# ---------- IDE / editor ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS junk ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store